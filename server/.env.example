# PostgreSQL database connection string for development and production
DATABASE_URL="postgresql://user:password@localhost:5432/project001?schema=public"

# JWT secrets used for signing access and refresh tokens
JWT_SECRET="your_jwt_secret"
JWT_REFRESH_SECRET="your_refresh_secret"

# Cookie secret for signing cookie values if needed
COOKIE_SECRET="your_cookie_secret"

# Admin account credentials or seed values
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="<bcrypt-hash>"

# Cloudinary credentials for media upload and hosting
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
